APP_NAME="StockPro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Product pictures are served from /storage on the current host by default,
# which is what you want. Uncomment and set this only to move images to a CDN.
# APP_STORAGE_URL=https://cdn.example.com/storage

# Where product pictures are stored. "public" keeps them on this server, which
# is correct for a normal server. Hosts that run the app in a container give it
# a throwaway disk, so every deploy would wipe the pictures: on those set this
# to s3 and fill in the AWS_ values at the bottom of this file.
IMAGE_DISK=public

# Interface language the app opens in. Change to en for English.
# The fallback stays en, so any string not yet translated shows readable
# English rather than a raw key name.
APP_LOCALE=km
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_CURRENCY_SYMBOL=$

# Printed at the top of every invoice and receipt. Blank lines are left off.
#
# Wrap any value containing a space in double quotes, for example
# APP_SHOP_ADDRESS="12 Street 271, Phnom Penh". Without the quotes the file
# fails to parse and no artisan command will run at all.
APP_SHOP_ADDRESS=
APP_SHOP_PHONE=
APP_SHOP_TAX_NUMBER=
APP_SHOP_FOOTER=

# Password for the accounts created by the seeder. Leave blank and a strong one
# is generated and printed once. Existing accounts are never overwritten.
SEED_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=system_management_stock
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email sending, pre-filled for Gmail.
#
# Kept on "log" so the app still works before credentials exist: messages are
# written to storage/logs/laravel.log instead of being delivered.
#
# To send through Gmail for real:
#   1. Turn on 2-Step Verification on the Google account.
#   2. Create a 16 character App Password at
#      Google Account > Security > App passwords.
#      A normal Gmail password will NOT work, Google blocked those in 2025.
#   3. Set MAIL_USERNAME and MAIL_FROM_ADDRESS to that Gmail address, and
#      MAIL_PASSWORD to the App Password with the spaces removed.
#   4. Change MAIL_MAILER from "log" to "smtp".
#   5. Confirm it with: php artisan mail:test you@example.com
#
# Google Workspace accounts on a custom domain need OAuth 2.0 instead of an
# App Password. For those, a transactional provider is usually less work.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
